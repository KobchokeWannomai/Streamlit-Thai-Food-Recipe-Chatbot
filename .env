# ตัวอย่างการตั้งค่า Environment Variables
# คัดลอกไฟล์นี้เป็น .env และกรอกค่าที่ต้องการ

# USDA FoodData Central API Key
# สมัครฟรีได้ที่: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=udyaSCqY4F6wN4yzLJL4peSTHlGSxoDq5FoXHJTw

# การตั้งค่าระบบ
LOG_LEVEL=INFO
MAX_API_CALLS_PER_MINUTE=60
CACHE_DURATION_HOURS=24

# การตั้งค่าแชทบอท
DEFAULT_SIMILARITY_THRESHOLD=0.3
MAX_SEARCH_RESULTS=5

# การตั้งค่าการแสดงผล
SHOW_NUTRITION_CHARTS=true
DEFAULT_NUTRITION_UNIT=per_100g
LANGUAGE=th

# หมายเหตุ:
# - ลบบรรทัดที่ไม่ต้องการใช้
# - ค่าที่มี # ข้างหน้าจะถูกละเว้น
# - ตรวจสอบให้แน่ใจว่าไม่มีช่องว่างรอบเครื่องหมาย =
