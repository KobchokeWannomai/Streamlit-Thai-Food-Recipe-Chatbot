# การตั้งค่าแชทบอทอาหารไทย - คัดลอกไฟล์นี้เป็น .env และใส่ค่าจริง

# =============================================================================
# การตั้งค่า API สำหรับข้อมูลโภชนาการ (ทางเลือก แต่แนะนำ)
# =============================================================================

# USDA FoodData Central API (ฟรี - แนะนำมาก!)
# สมัครที่: https://fdc.nal.usda.gov/api-guide.html
# ประโยชน์: ฟรี ไม่จำกัดการใช้งาน ข้อมูลจากรัฐบาลสหรัฐ
USDA_API_KEY=your_usda_api_key_here

# Nutritionix API (ทางเลือก - 200 ครั้ง/วัน ฟรี)
# สมัครที่: https://www.nutritionix.com/business/api
# ประโยชน์: ฐานข้อมูลอาหารที่หลากหลาย รองรับภาษาธรรมชาติ
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here

# =============================================================================
# การเปิด/ปิดฟีเจอร์
# =============================================================================

# การค้นหาขั้นสูง
ENABLE_ENHANCED_SEARCH=true
ENABLE_QUERY_EXPANSION=true

# การวิเคราะห์โภชนาการ
ENABLE_API_INTEGRATION=true
ENABLE_COOKING_ADJUSTMENTS=true
ENABLE_MISSING_INGREDIENT_DETECTION=true

# ประสบการณ์ผู้ใช้
ENABLE_AUTO_SCROLL=true
ENABLE_SMOOTH_ANIMATIONS=true

# =============================================================================
# การตั้งค่าประสิทธิภาพ
# =============================================================================

# API
API_TIMEOUT=10
API_RETRY_ATTEMPTS=3
API_RATE_LIMIT_PER_MINUTE=30

# แคช
CACHE_DURATION_HOURS=24
NUTRITION_CACHE_EXPIRE_DAYS=30
MAX_CACHE_SIZE_MB=100

# การค้นหา
MAX_SEARCH_RESULTS=10
SIMILARITY_THRESHOLD=0.3
ENHANCED_SIMILARITY_THRESHOLD=0.25

# =============================================================================
# การตั้งค่าการแสดงผล
# =============================================================================

# ธีม
APP_THEME=light
PRIMARY_COLOR=#4CAF50
SECONDARY_COLOR=#2196F3

# การแสดงผล
DEFAULT_LANGUAGE=th
SHOW_DETAILED_NUTRITION=true
SHOW_COOKING_ADJUSTMENTS=true
MAX_RECIPES_PER_SEARCH=10

# แอนิเมชั่น
AUTO_SCROLL_DELAY=500
ANIMATION_DURATION=300

# =============================================================================
# การบันทึกล็อก
# =============================================================================

LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=false
ENABLE_API_LOGGING=true
LOG_TO_FILE=true

# =============================================================================
# การพัฒนา
# =============================================================================

DEBUG_MODE=false
DEVELOPMENT_MODE=false
ENABLE_TEST_DATA=false

# =============================================================================
# คำแนะนำการใช้งาน
# =============================================================================

# วิธีใช้ไฟล์นี้:
# 1. คัดลอกไฟล์นี้เป็น .env (cp .env.example .env)
# 2. แทนที่ 'your_*_here' ด้วย API keys จริง
# 3. ปรับ true/false ตามความต้องการ
# 4. สำหรับการใช้งานจริง ให้รักษาไฟล์ .env ให้ปลอดภัย

# ลำดับความสำคัญสำหรับการเริ่มต้น:
# 1. USDA_API_KEY - ฟรี และให้ข้อมูลโภชนาการครบถ้วน
# 2. ENABLE_ENHANCED_SEARCH=true - ผลการค้นหาดีขึ้น
# 3. ENABLE_COOKING_ADJUSTMENTS=true - การคำนวณแม่นยำขึ้น
# 4. ENABLE_AUTO_SCROLL=true - ประสบการณ์ใช้งานดีขึ้น

# การรักษาความปลอดภัย:
# - อย่า commit ไฟล์ .env เข้า git
# - ใช้ API keys ที่แข็งแกร่งและไม่ซ้ำกัน
# - หมุนเวียน API keys เป็นประจำ
# - ตรวจสอบการใช้งาน API เพื่อตรวจหาการเข้าถึงที่ผิดปกติ
