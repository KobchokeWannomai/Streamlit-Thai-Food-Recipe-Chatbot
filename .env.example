# Thai Food Recipe Chatbot - Environment Variables Example
# Copy this file to .env and fill in your API keys

# USDA FoodData Central API (Free)
# Get your key from: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=your_usda_api_key_here

# Nutritionix API (Optional)
# Get your credentials from: https://www.nutritionix.com/business/api
NUTRITIONIX_API_KEY=your_nutritionix_api_key_here
NUTRITIONIX_APP_ID=your_nutritionix_app_id_here

# Configuration
LOG_LEVEL=INFO
BATCH_SIZE=5
API_TIMEOUT=10

# Note: The system will work without API keys using the built-in Thai food database
# API keys will provide more accurate and comprehensive nutrition data
